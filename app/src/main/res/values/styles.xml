<resources>

    <style name="BaseTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/page</item>
    </style>

    <style name="AppTheme" parent="BaseTheme" />

    <style name="WidgetText">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:shadowColor">#66000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">3</item>
    </style>

    <style name="WidgetText.Temp">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="WidgetText.Detail">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="WidgetText.Meta">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

</resources>
